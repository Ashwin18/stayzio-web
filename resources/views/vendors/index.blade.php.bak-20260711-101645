@php
  use Illuminate\Support\Facades\DB;
  use Illuminate\Support\Str;

  $sym = $settings->base_currency_symbol ?? '₹';
  $pos = $settings->base_currency_symbol_position ?? 'left';
  $fmt = fn($v) => $pos==='left' ? $sym.number_format($v,0) : number_format($v,0).$sym;

  $vendor    = Auth::guard('vendor')->user();
  $vendorId  = $vendor->id;
  $now       = \Carbon\Carbon::now();
  $today     = $now->toDateString();
  $monthStart= $now->copy()->startOfMonth()->toDateString();
  $hour      = $now->hour;
  $greeting  = $hour < 12 ? 'morning' : ($hour < 17 ? 'afternoon' : 'evening');

  // ── KPI: Bookings ──
  $totalBookings  = DB::table('bookings')->where('vendor_id',$vendorId)->count();
  $paidBookings   = DB::table('bookings')->where('vendor_id',$vendorId)
    ->where(function($q){ $q->where('payment_status',1)->orWhere('payment_status','paid'); })->count();
  $pendingBookings= DB::table('bookings')->where('vendor_id',$vendorId)
    ->where('payment_status',0)->where('order_status','!=','cancelled')->count();
  $cancelledBookings = DB::table('bookings')->where('vendor_id',$vendorId)
    ->where('order_status','cancelled')->count();

  // ── KPI: Revenue ──
  $totalRevenue = DB::table('bookings')->where('vendor_id',$vendorId)
    ->where(function($q){ $q->where('payment_status',1)->orWhere('payment_status','paid'); })
    ->selectRaw('SUM(grand_total - COALESCE(commission_price,0)) as net')
    ->value('net') ?? 0;
  $todayRevenue = DB::table('bookings')->where('vendor_id',$vendorId)
    ->whereDate('created_at',$today)
    ->where(function($q){ $q->where('payment_status',1)->orWhere('payment_status','paid'); })
    ->selectRaw('SUM(grand_total - COALESCE(commission_price,0)) as net')
    ->value('net') ?? 0;
  $monthRevenue = DB::table('bookings')->where('vendor_id',$vendorId)
    ->whereDate('created_at','>=',$monthStart)
    ->where(function($q){ $q->where('payment_status',1)->orWhere('payment_status','paid'); })
    ->selectRaw('SUM(grand_total - COALESCE(commission_price,0)) as net')
    ->value('net') ?? 0;
  $todayBookings= DB::table('bookings')->where('vendor_id',$vendorId)
    ->whereDate('created_at',$today)->count();
  $monthBookings= DB::table('bookings')->where('vendor_id',$vendorId)
    ->whereDate('created_at','>=',$monthStart)->count();

  // ── Hotels & Rooms ──
  $totalHotels    = DB::table('hotels')->where('vendor_id',$vendorId)->count();
  $approvedHotels = DB::table('hotels')->where('vendor_id',$vendorId)->where('approval_status',1)->count();
  $pendingHotels  = DB::table('hotels')->where('vendor_id',$vendorId)->where('approval_status',0)->count();
  $totalRooms     = DB::table('rooms')->where('vendor_id',$vendorId)->count();

  // ── Revenue by Hotel ──
  $revenueByHotel = DB::table('bookings')
    ->join('hotel_contents','bookings.hotel_id','=','hotel_contents.hotel_id')
    ->join('languages','hotel_contents.language_id','=','languages.id')
    ->where('bookings.vendor_id',$vendorId)
    ->where(function($q){ $q->where('bookings.payment_status',1)->orWhere('bookings.payment_status','paid'); })
    ->where('languages.is_default',1)
    ->select('hotel_contents.title as hotel_name',
             DB::raw('COUNT(bookings.id) as bookings'),
             DB::raw('SUM(bookings.grand_total - COALESCE(bookings.commission_price,0)) as total'))
    ->groupBy('bookings.hotel_id','hotel_contents.title')
    ->orderByDesc('total')->get();
  $maxHotelRev = $revenueByHotel->max('total') ?: 1;

  // ── My Hotels ──
  $myHotels = DB::table('hotels')
    ->leftJoin('hotel_contents','hotels.id','=','hotel_contents.hotel_id')
    ->leftJoin('languages','hotel_contents.language_id','=','languages.id')
    ->where('hotels.vendor_id',$vendorId)
    ->where(function($q){ $q->where('languages.is_default',1)->orWhereNull('languages.is_default'); })
    ->select('hotels.id','hotels.approval_status','hotel_contents.title as hotel_name','hotel_contents.slug')
    ->get();

  // ── Recent Bookings ──
  $recentBookings = DB::table('bookings')
    ->leftJoin('hotel_contents', function($j){
        $j->on('hotel_contents.hotel_id','=','bookings.hotel_id')
          ->whereExists(function($s){
              $s->select(DB::raw(1))->from('languages')
                ->whereColumn('languages.id','hotel_contents.language_id')
                ->where('languages.is_default',1);
          });
    })
    ->leftJoin('room_contents', function($j){
        $j->on('room_contents.room_id','=','bookings.room_id')
          ->whereExists(function($s){
              $s->select(DB::raw(1))->from('languages')
                ->whereColumn('languages.id','room_contents.language_id')
                ->where('languages.is_default',1);
          });
    })
    ->where('bookings.vendor_id',$vendorId)
    ->select(
        'bookings.id','bookings.order_number','bookings.grand_total','bookings.commission_price',
        'bookings.payment_status','bookings.order_status',
        'bookings.check_in_date','bookings.check_in_time','bookings.hour',
        'bookings.created_at','bookings.booking_name','bookings.booking_phone',
        'hotel_contents.title as hotel_name',
        'room_contents.title as room_name'
    )
    ->orderByDesc('bookings.created_at')->limit(8)->get();

  // ── Monthly bookings chart ──
  $months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  $monthlyData = [];
  for($m=1;$m<=12;$m++){
    $monthlyData[] = DB::table('bookings')
      ->where('vendor_id',$vendorId)
      ->whereMonth('created_at',$m)->whereYear('created_at',$now->year)->count();
  }
  $maxMo = max(array_merge($monthlyData,[1]));
@endphp

