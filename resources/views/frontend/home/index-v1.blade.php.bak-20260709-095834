    if (durationSection) durationSection.style.display = '';
    // restore whichever duration pill is currently marked active
    var activePill = document.querySelector('#szDurationPills button.active');
    szSelectedHours = activePill ? activePill.dataset.hours : '3';
  }
}

function szSetDuration(el) {
  document.querySelectorAll('#szDurationPills button').forEach(b => b.classList.remove('active'));
  el.classList.add('active');
  szSelectedHours = el.dataset.hours;
}

function submitHomeSearch() {
  var city       = document.querySelector('.selected-city')?.textContent?.trim().replace(/[▼›]/g,'').trim() || '';
  var date       = document.getElementById('dateRangeDisplay')?.dataset?.date || '';
  var time       = document.querySelector('.selected-time')?.textContent?.trim().replace(/[▼›⌄]/g,'').trim() || '';
