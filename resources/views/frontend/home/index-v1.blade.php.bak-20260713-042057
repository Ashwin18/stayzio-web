<script>
// ── HOME PAGE SEARCH ──────────────────────────
var szStayType     = 'hourly';
var szSelectedHours = '3';

// ── Hero banner slider ──────────────────────────
(function() {
  var slides = document.querySelectorAll('#szHeroSlider .sz-hero-slide');
  var dots   = document.querySelectorAll('#szHeroDots button');
  if (slides.length <= 1) return;

  var current = 0;
  var timer = setInterval(next, 5000);

  function show(i) {
    slides.forEach(s => s.classList.remove('active'));
    dots.forEach(d => d.classList.remove('active'));
    slides[i].classList.add('active');
    if (dots[i]) dots[i].classList.add('active');
    current = i;
  }
  function next() {
    show((current + 1) % slides.length);
  }
  window.szGoToSlide = function(i) {
    clearInterval(timer);
    show(i);
    timer = setInterval(next, 5000);
  };
})();

function szSetStayType(el) {
  szStayType = el.dataset.stay;
  document.querySelectorAll('#szStayTabs button').forEach(b => b.classList.remove('active'));
  el.classList.add('active');

  if (szStayType === 'fullday') {
    // Full-Day tab auto-selects the "Day" duration pill
    document.querySelectorAll('#szDurationPills button').forEach(b => b.classList.remove('active'));
    var dayBtn = document.querySelector('#szDurationPills button[data-hours="24"]');
    if (dayBtn) dayBtn.classList.add('active');
    szSelectedHours = '24';
  } else {
