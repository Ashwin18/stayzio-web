    propParams.set('hour', szSelectedHours);
    var sep = window.szSelectedPropertyUrl.indexOf('?') === -1 ? '?' : '&';
    window.location.href = window.szSelectedPropertyUrl + sep + propParams.toString();
    return;
  }

  var city = document.querySelector('.selected-city')?.textContent?.trim().replace(/[▼›]/g,'').trim() || '';
  var params = new URLSearchParams();
  if (window.szSelectedCityId) {
    params.set('filter_city', window.szSelectedCityId);
  } else if (city && city !== 'All Cities') {
    params.set('location_val', city);
  }
  if (date) params.set('date_range', date);
  if (time) params.set('check_time', time);
  params.set('hour', szSelectedHours);

  var finalUrl = '{{ route("frontend.rooms") }}?' + params.toString();
  alert('DIAGNOSTIC:\ndate=' + date + '\ntime=' + time + '\ncity text=' + city + '\nszSelectedCityId=' + window.szSelectedCityId + '\nszSelectedPropertyUrl=' + window.szSelectedPropertyUrl + '\n\nFinal URL:\n' + finalUrl);
  window.location.href = finalUrl;
}

// ── Time picker: built from scratch (previously had no wiring at all) ──
(function() {
  var timeDropdown = document.getElementById('timeDropdown');
  if (!timeDropdown) return;
  var selectedTimeEl = timeDropdown.querySelector('.selected-time');
  var timeBox = timeDropdown.querySelector('.time-box');
  var timeList = timeDropdown.querySelector('.time-list');
  var toggleBtns = timeDropdown.querySelectorAll('.time-toggle button');
  var activePeriod = 'pm';

  function pad(n) { return n < 10 ? '0'+n : ''+n; }

  function formatTime(h24, m) {
    var period = h24 >= 12 ? 'PM' : 'AM';
    var h12 = h24 % 12; if (h12 === 0) h12 = 12;
    return pad(h12) + ':' + pad(m) + ' ' + period;
  }

  function renderTimeList() {
    var now = new Date();
    var selectedDateStr = document.getElementById('dateRangeDisplay')?.dataset?.date || '';
    var todayStr = now.getFullYear() + '-' + pad(now.getMonth()+1) + '-' + pad(now.getDate());
    var isToday = selectedDateStr === todayStr || !selectedDateStr;
    var currentMinutes = now.getHours() * 60 + now.getMinutes();

    var startHour = activePeriod === 'am' ? 0 : 12;
    var endHour = activePeriod === 'am' ? 11 : 23;

    var html = '';
    for (var h = startHour; h <= endHour; h++) {
      for (var m = 0; m < 60; m += 30) {
        var slotMinutes = h * 60 + m;
        var disabled = isToday && slotMinutes <= currentMinutes;
        var label = formatTime(h, m);
        html += '<div class="time-opt' + (disabled ? ' time-opt-disabled' : '') + '"' +
                (disabled ? '' : ' onclick="szSelectTime(\'' + label + '\')"') + '>' + label + '</div>';
      }
    }
    if (timeList) timeList.innerHTML = html;
  }

  window.szSelectTime = function(label) {
    if (selectedTimeEl) {
      selectedTimeEl.innerHTML = label + ' <i class="fas fa-chevron-down arrow"></i>';
    }
    closeTimeBox();
  };

  function openTimeBox() {
    renderTimeList();
    if (timeBox) timeBox.style.display = 'block';
  }
  function closeTimeBox() {
    if (timeBox) timeBox.style.display = 'none';
  }

  if (selectedTimeEl) {
    selectedTimeEl.addEventListener('click', function(e) {
      e.stopPropagation();
      if (timeBox && timeBox.style.display === 'block') { closeTimeBox(); } else { openTimeBox(); }
    });
  }

  toggleBtns.forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      toggleBtns.forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      activePeriod = btn.dataset.type;
      renderTimeList();
    });
  });

  document.addEventListener('click', function(e) {
    if (!timeDropdown.contains(e.target)) closeTimeBox();
  });
})();

// ── Live autosuggest: Area + Property, Brevistay-style ──
(function() {
  var wrap        = document.getElementById('locationDropdown');
  var displayText  = wrap ? wrap.querySelector('.selected-city') : null;
  var searchInput = document.getElementById('szLocationSearchInput');
  var listBox      = document.getElementById('szLocationSuggestList');
  var debounceTimer;
  window.szSelectedPropertyUrl = null;

  if (!wrap || !searchInput || !listBox) return;

  var defaultListHtml = listBox.innerHTML;

  function openSearchMode() {
    displayText.style.display = 'none';
    searchInput.style.display = 'block';
    searchInput.value = '';
    searchInput.focus();
    listBox.innerHTML = defaultListHtml;
    listBox.style.display = 'block';
    bindStaticItems();
  }

  function closeSearchMode(selectedLabel) {
    searchInput.style.display = 'none';
    displayText.style.display = 'block';
    listBox.style.display = 'none';
    if (selectedLabel) {
      displayText.innerHTML = selectedLabel + ' <i class="fas fa-chevron-down"></i>';
    }
    wrap.classList.remove('active');
  }

  function bindStaticItems() {
    listBox.querySelectorAll('li[data-type]').forEach(function(li) {
      li.addEventListener('click', function(e) {
        e.stopPropagation();
        selectSuggestion(this.dataset.type, this.dataset.name, this.dataset.id, this.dataset.url);
      });
    });
  }

  function selectSuggestion(type, name, id, url) {
    if (type === 'Property' && url) {
      window.szSelectedPropertyUrl = url;
    } else {
      window.szSelectedPropertyUrl = null;
    }
    window.szSelectedCityId = (type === 'Area' && id) ? id : null;
    closeSearchMode(name);
  }
  window.szSelectSuggestion = selectSuggestion;

  bindStaticItems();

  wrap.addEventListener('click', function(e) {
    if (e.target.closest('.dropdown-list') || e.target === searchInput) return;
    if (!wrap.classList.contains('active')) {
      wrap.classList.add('active');
      openSearchMode();
    } else {
      wrap.classList.remove('active');
      searchInput.style.display = 'none';
      displayText.style.display = 'block';
      listBox.style.display = 'none';
    }
  });

  searchInput.addEventListener('input', function() {
    var q = searchInput.value.trim();
    clearTimeout(debounceTimer);
    window.szSelectedPropertyUrl = null;

    if (q.length < 2) {
      listBox.innerHTML = defaultListHtml;
      bindStaticItems();
      return;
    }

    debounceTimer = setTimeout(function() {
      fetch('{{ route("search.suggest") }}?q=' + encodeURIComponent(q))
        .then(function(r) { return r.json(); })
        .then(function(data) {
          renderSuggestions(data);
        })
        .catch(function() {
          listBox.innerHTML = '<li class="sz-suggest-empty">Search unavailable, try again</li>';
        });
    }, 220);
  });

  function renderSuggestions(data) {
    var areas = data.filter(function(d) { return d.type === 'Area'; });
    var properties = data.filter(function(d) { return d.type === 'Property'; });

    if (!areas.length && !properties.length) {
      listBox.innerHTML = '<li class="sz-suggest-empty">No matches found</li>';
      return;
    }

    var html = '';
    areas.forEach(function(a) {
      html += '<li class="sz-suggest-item" data-type="Area" data-id="' + a.id + '" data-name="' + escapeHtml(a.name) + '">' +
              '<span>' + escapeHtml(a.name) + '</span><span class="sz-suggest-tag">Area</span></li>';
    });
    properties.forEach(function(p) {
      html += '<li class="sz-suggest-item" data-type="Property" data-id="' + p.id + '" data-name="' + escapeHtml(p.name) + '" data-url="' + p.url + '">' +
              '<span>' + escapeHtml(p.name) + '</span><span class="sz-suggest-tag">Property</span></li>';
    });
    listBox.innerHTML = html;
    bindStaticItems();
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, function(c) {
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }

  document.addEventListener('click', function(e) {
    if (!e.target.closest('#locationDropdown')) {
      wrap.classList.remove('active');
      listBox.style.display = 'none';
      if (searchInput.style.display !== 'none') {
        searchInput.style.display = 'none';
        displayText.style.display = 'block';
      }
    }
  });
})();

// Store selected date for search
document.getElementById('applyDateBtn')?.addEventListener('click', function() {
  var display = document.getElementById('dateRangeDisplay');
  if(display) {
    // Get the first selected date from calendar
    var selected = document.querySelector('.calendar-day.selected, .day.selected, [data-date].selected');
    if(selected && selected.dataset.date) {
      display.dataset.date = selected.dataset.date;
    } else {
      display.dataset.date = new Date().toISOString().split('T')[0];
    }
  }
  document.getElementById('customDatePopup')?.classList.remove('show', 'active', 'open');
});
