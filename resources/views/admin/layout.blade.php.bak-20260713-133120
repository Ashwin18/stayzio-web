<script>
var notifOpen = false;
function toggleNotifDropdown() {
  notifOpen = !notifOpen;
  var d = document.getElementById('notifDropdown');
  d.style.display = notifOpen ? 'block' : 'none';
  if (notifOpen) loadNotifications();
}
document.addEventListener('click', function(e) {
  if (notifOpen && !document.getElementById('notifBell').contains(e.target) && !document.getElementById('notifDropdown').contains(e.target)) {
    notifOpen = false;
    document.getElementById('notifDropdown').style.display = 'none';
  }
});
function loadNotifications() {
  fetch('{{ route("admin.notifications.dropdown") }}')
    .then(r => r.json())
    .then(data => {
      var list = document.getElementById('notifList');
      var colors = {
        blue:   {bg:'#eff6ff',border:'#bfdbfe',text:'#1d4ed8'},
        green:  {bg:'#f0fdf4',border:'#bbf7d0',text:'#15803d'},
        red:    {bg:'#fff1f1',border:'#fecaca',text:'#dc2626'},
        amber:  {bg:'#fffbeb',border:'#fde68a',text:'#d97706'},
        purple: {bg:'#faf5ff',border:'#e9d5ff',text:'#7c3aed'},
      };
      if (data.items.length === 0) {
        list.innerHTML = '<div style="padding:30px;text-align:center;color:#6b6560;font-size:12px"><i class="ti ti-bell-off" style="font-size:28px;display:block;margin-bottom:8px;opacity:.4"></i>No notifications</div>';
        return;
      }
      var html = '';
      data.items.forEach(function(n) {
        var c = colors[n.color] || colors.blue;
        var url = '{{ route("admin.notifications.read", ":id") }}'.replace(':id', n.id);
        html += '<a href="' + url + '" class="notif-item' + (!n.is_read ? ' unread' : '') + '">';
        html += '<div class="notif-item-icon" style="background:' + c.bg + ';border:1px solid ' + c.border + '">';
        html += '<i class="ti ' + n.icon + '" style="color:' + c.text + '"></i></div>';
        html += '<div class="notif-item-body">';
        html += '<div class="notif-item-title">' + n.title + '</div>';
        html += '<div class="notif-item-msg">' + n.message + '</div>';
        html += '<div class="notif-item-time">' + timeAgo(n.created_at) + '</div>';
        html += '</div>';
        if (!n.is_read) html += '<div class="notif-unread-dot"></div>';
        html += '</a>';
      });
      list.innerHTML = html;
      // Update badge
      var badge = document.getElementById('notifBadge');
      var dot = document.getElementById('notifDot');
      if (badge) badge.textContent = data.unread > 0 ? (data.unread > 99 ? '99+' : data.unread) : '';
      if (badge && data.unread === 0) badge.style.display = 'none';
      if (dot && data.unread === 0) dot.style.display = 'none';
    });
}
function markAllRead() {
  fetch('{{ route("admin.notifications.mark_all_read") }}', {
    method:'POST',
    headers:{'X-CSRF-TOKEN':'{{ csrf_token() }}','Content-Type':'application/json'}
  }).then(() => {
    var badge = document.getElementById('notifBadge');
    var dot = document.getElementById('notifDot');
    if (badge) badge.style.display = 'none';
    if (dot) dot.style.display = 'none';
    loadNotifications();
  });
}
function timeAgo(ts) {
  var d = new Date(ts.replace(' ', 'T'));
  var diff = Math.floor((Date.now() - d) / 1000);
  if (diff < 60) return diff + 's ago';
  if (diff < 3600) return Math.floor(diff/60) + 'm ago';
  if (diff < 86400) return Math.floor(diff/3600) + 'h ago';
  return Math.floor(diff/86400) + 'd ago';
}
// Auto-refresh unread count every 60s
setInterval(function() {
  fetch('{{ route("admin.notifications.dropdown") }}')
    .then(r => r.json())
    .then(data => {
      var badge = document.getElementById('notifBadge');
      var dot = document.getElementById('notifDot');
      if (badge) {
        badge.textContent = data.unread > 0 ? (data.unread > 99 ? '99+' : data.unread) : '';
        badge.style.display = data.unread > 0 ? 'flex' : 'none';
      }
      if (dot) dot.style.display = data.unread > 0 ? 'block' : 'none';
    });
}, 60000);
</script>
