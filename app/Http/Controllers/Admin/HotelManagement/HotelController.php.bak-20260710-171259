    public function approveHotel(Request $request, $id)
    {
        $hotel = \App\Models\Hotel::findOrFail($id);
        $hotel->update(['approval_status' => 1, 'status' => 1]);
        
        // Notify vendor
        $vendor = $hotel->vendor;
        if ($vendor) {
            \Illuminate\Support\Facades\Session::flash('success', 'Hotel approved and is now live on the platform.');
        }
        return redirect()->back()->with('success', 'Hotel approved successfully.');
    }

    public function rejectHotel(Request $request, $id)
    {
        $hotel = \App\Models\Hotel::findOrFail($id);
        $hotel->update(['approval_status' => 2, 'status' => 0]);
        return redirect()->back()->with('success', 'Hotel rejected.');
    }

    public function pendingHotels(Request $request)
