    public function edit($id)
    {
        $vendorId = Hotel::where('id', $id)->pluck('vendor_id')->first();
        $defaultLang = Language::query()->where('is_default', 1)->first();
        if ($vendorId != 0) {
            $current_package = VendorPermissionHelper::packagePermission($vendorId);

