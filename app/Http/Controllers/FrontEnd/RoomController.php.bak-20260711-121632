class RoomController extends Controller
{    
   public function index(Request $request)
{
    $view = Basic::query()->pluck('room_view')->first();

    $misc = new MiscellaneousController();
    $language = $misc->getLanguage();

    $information['bgImg'] = $misc->getBreadcrumb();
    $information['pageHeading'] = $misc->getPageHeading($language);
    $information['language'] = $language;

    $information['seoInfo'] = $language->seoInfo()
        ->select('meta_keyword_rooms', 'meta_description_rooms')
        ->first();

    $information['currencyInfo'] = $this->getCurrencyInfo();

    $title = null;
    $address = null;
    $category = null;
    $ratings = null;
    $checkInDates = null;
    $amenitie = null;
    $hotelId = null;
    $country = null;
    $state = null;
    $city = null;
    $location = null;

    // Catching date and time parameters from URL query format
    if ($request->filled('date_range')) {
        $checkInDates = $request->date_range;
    }

    if ($request->filled('check_time')) {
        try {
            $checkInTimes = Carbon::parse($request->check_time)->format('H:i:s');
        } catch (\Exception $e) {
            $checkInTimes = '00:00:00';
        }
    } else {
        $checkInTimes = null;
    }

    if ($request->filled('hour')) {
        $hour = (int)$request->hour;
    } else {
        $hour = (int)BookingHour::max('hour');
    }

    // 1. Price Range Filter Logic (Hourly Price Verification)
    $priceFilteredRoomIds = null;
    if ($request->filled('min_price') || $request->filled('max_price')) {
        $minPrice = $request->query('min_price', 0);
        $maxPrice = $request->query('max_price', 9999999);

        // Fetching eligible room IDs that fit the price scale for the requested hour duration
        $priceFilteredRoomIds = HourlyRoomPrice::where('hour', $hour)
            ->whereBetween('price', [$minPrice, $maxPrice])
            ->pluck('room_id')
            ->toArray();
    }

    $rooms = Room::get();
    $roomtimeIds = [];

    // 2. Room Availability Loop (Bookings, Holidays, and Daily Inventories Check)
    if ($checkInDates) {
        $check_in_date = date('Y-m-d', strtotime($checkInDates));
        $check_in_time = date('H:i:s', strtotime($checkInTimes ?? '00:00:00'));
        $check_in_date_time = $check_in_date . ' ' . $check_in_time;

        // Calculate checkout metrics
        $check_out_time = date('H:i:s', strtotime($check_in_time . " +{$hour} hour"));
        list($current_hour, $current_minute, $current_second) = explode(':', $check_in_time);
        $total_hours = (int)$current_hour + $hour;

        $next_booking_time_for_next_day = sprintf('%02d:%02d:%02d', $total_hours, $current_minute, $current_second);
        $checkoutTimeLimit = '23:59:59';

        if ($checkoutTimeLimit < $next_booking_time_for_next_day) {
            $checkoutDate = date('Y-m-d', strtotime($check_in_date . ' +1 day'));
        } else {
            $checkoutDate = date('Y-m-d', strtotime($check_in_date));
        }

        foreach ($rooms as $room) {
            $id = $room->id;
            $preparation_time = $room->preparation_time;
            $bookingStatus = false;

            $next_booking_time = date('H:i:s', strtotime($check_out_time . " +$preparation_time min"));
            $check_out_date_time = $checkoutDate . ' ' . $next_booking_time;

            // Check Holidays
            $holiday = Holiday::where('hotel_id', $room->hotel_id)->get();
            $convertedHolidays = array_map(function ($h) {
                return Carbon::parse($h['date'])->format('Y-m-d');
            }, $holiday->toArray());

            if (in_array($checkoutDate, $convertedHolidays) || in_array($check_in_date, $convertedHolidays)) {
                // Room is closed due to holiday constraints
                $roomtimeIds[] = $id;
                continue;
            }

            // A. Check Core Inventory Structure via hotel_daily_inventories
            // Assuming columns: room_id, date, total_inventory, booked_count, and status (1=available, 0=out of order)
           
           $dailyInventory = \DB::table('hotel_daily_inventories')
    ->join('rooms', 'hotel_daily_inventories.hotel_id', '=', 'rooms.hotel_id')
    ->where('rooms.id', $id)
    ->where('hotel_daily_inventories.date', $check_in_date)
    ->select('hotel_daily_inventories.*') // Optional: multi-table joins can overwrite columns, so specify what you need
    ->first();
           
           
            $dailyInventory = \DB::table('hotel_daily_inventories')
                ->where('room_id', $id)
                ->where('date', $check_in_date)
                ->first();

            if ($dailyInventory) {
                // If the inventory record explicitly says out of order or closed
                if (isset($dailyInventory->status) && $dailyInventory->status == 0) {
                    $roomtimeIds[] = $id;
                    continue;
                }
                // Determine maximum available capacity based on inventory row
                $totalRoom = $dailyInventory->total_inventory - $dailyInventory->booked_count;
            } else {
                // Fallback to room's static layout structure if no specific inventory date entry is tracked
                $totalRoom = $room->number_of_rooms_of_this_same_type;
            }

            // B. Cross-examine active dynamic hour booking conflicts
            $totalBookingDone = Booking::where('room_id', $id)
                ->where('payment_status', '!=', 2)
                ->where(function ($query) use ($check_in_date_time, $check_out_date_time) {
                    $query->where(function ($q) use ($check_in_date_time, $check_out_date_time) {
                        $q->whereBetween('check_in_date_time', [$check_in_date_time, $check_out_date_time])
                          ->orWhereBetween('check_out_date_time', [$check_in_date_time, $check_out_date_time]);
                    })
                    ->orWhere(function ($q) use ($check_in_date_time, $check_out_date_time) {
                        $q->where('check_in_date_time', '<=', $check_in_date_time)
                          ->where('check_out_date_time', '>=', $check_out_date_time);
                    });
                })
                ->count();

            // Room has remaining capacity or passes constraints
            if ($totalRoom > $totalBookingDone) {
                $bookingStatus = true;
            }

            if (!$bookingStatus) {
                if (!in_array($id, $roomtimeIds)) {
                    $roomtimeIds[] = $id;
                }
            }
        }
    }

    $roomIds = [];
    if ($request->filled('title')) {
        $title = $request->title;
        $room_contents = RoomContent::where('language_id', $language->id)
            ->where('title', 'like', '%' . $title . '%')
            ->pluck('room_id');

        foreach ($room_contents as $room_content) {
            if (!in_array($room_content, $roomIds)) {
                $roomIds[] = $room_content;
            }
        }
    }

    $countryIds = [];
    if ($request->filled('country')) {
        $country = $request->country;
        $hotel_contents = HotelContent::where('language_id', $language->id)
            ->where('country_id', $country)
            ->pluck('hotel_id');

        foreach ($hotel_contents as $hotel_content) {
            if (!in_array($hotel_content, $countryIds)) {
                $countryIds[] = $hotel_content;
            }
        }
    }

    $stateIds = [];
    if ($request->filled('state')) {
        $state = $request->state;
        $hotel_contents = HotelContent::where('language_id', $language->id)
            ->where('state_id', $state)
            ->pluck('hotel_id');

        foreach ($hotel_contents as $hotel_content) {
            if (!in_array($hotel_content, $stateIds)) {
                $stateIds[] = $hotel_content;
            }
        }
    }

    $cityIds = [];
    if ($request->filled('city')) {
        $city = $request->city;
        $hotel_contents = HotelContent::where('language_id', $language->id)
            ->where('city_id', $city)
            ->pluck('hotel_id');

        foreach ($hotel_contents as $hotel_content) {
            if (!in_array($hotel_content, $cityIds)) {
                $cityIds[] = $hotel_content;
            }
        }
    }

    if ($request->filled('hotelId')) {
        $hotelId = $request->hotelId;
    }

    $category_roomIds = [];
    if ($request->filled('category')) {
        $category = $request->category;
        $category_content = RoomCategory::where([
            ['language_id', $language->id],
            ['slug', $category]
        ])->first();

        if (!empty($category_content)) {
            $category_id = $category_content->id;
            $contents = RoomContent::where('language_id', $language->id)
                ->where('room_category', $category_id)
                ->pluck('room_id');

            foreach ($contents as $content) {
                if (!in_array($content, $category_roomIds)) {
                    $category_roomIds[] = $content;
                }
            }
        }
    }

   $ratingIds = [];

if ($request->filled('ratings')) {
    $ratings = $request->ratings; // Expecting an integer/string value (e.g., 3, 4, 5)

    // Query rooms that belong to a hotel with a matching star rating
    $ratingIds = Room::whereHas('hotel', function ($query) use ($ratings) {
        $query->where('stars', '>=', $ratings);
    })->pluck('id')->toArray();
}

// Couple-friendly filter
$coupleFriendlyIds = [];
if ($request->filled('couple_friendly') && $request->couple_friendly == 1) {
    $coupleFriendlyIds = Room::whereHas('hotel', function ($query) {
        $query->where('couple_friendly', 1);
    })->pluck('id')->toArray();
}

// Guest Type (room category) filter - multi-select
$categoryFilteredIds = [];
if ($request->filled('filter_category')) {
    $catIds = $request->input('filter_category');
    if (!is_array($catIds)) $catIds = [(int)$catIds];
    $catIds = array_map('intval', $catIds);
    $categoryFilteredIds = \App\Models\RoomContent::whereIn('room_category', $catIds)
        ->pluck('room_id')->toArray();
}

// City filter — expanded to include admin-linked nearby areas, selected area ranks first via ordering below
$cityFilteredIds = [];
$filterCity = null;
if ($request->filled('filter_city')) {
    $filterCity = (int)$request->filter_city;
    $nearbyCityIds = \Illuminate\Support\Facades\DB::table('city_nearby_links')
        ->where('city_id', $filterCity)
        ->pluck('nearby_city_id')
        ->toArray();
    $allCityIds = array_merge([$filterCity], $nearbyCityIds);
    $cityHotelIds = \App\Models\HotelContent::whereIn('city_id', $allCityIds)->pluck('hotel_id')->toArray();
    if (!empty($cityHotelIds)) {
        $cityFilteredIds = Room::whereIn('hotel_id', $cityHotelIds)->pluck('id')->toArray();
    } else {
        $cityFilteredIds = [0]; // No match
    }
}

    $amenitieIds = [];
    if ($request->filled('amenitie')) {
        $amenitie = $request->amenitie;
        $array = explode(',', $amenitie);
        $contents = RoomContent::where('language_id', $language->id)->get(['room_id', 'amenities']);

        foreach ($contents as $content) {
            $amenities = json_decode($content->amenities ?? '[]', true) ?? [];
            $roomId = $content->room_id;
            $diff1 = array_diff($array, $amenities);
            $diff2 = array_diff($array, $amenities);

            if (empty($diff1) && empty($diff2)) {
                $amenitieIds[] = $roomId;
            }
        }
    }

    $addressIds = [];
    $lat_long = [];
    $bs = Basic::select('google_map_api_key_status', 'radius', 'google_map_api_key')->first();

    if ($request->filled('location_val')) {
        if ($bs->google_map_api_key_status == 1) {
            $location = $request->location_val;
            $lat_long = GeoSearch::getCoordinates($location, $bs->google_map_api_key);
        } else {
            $address = $request->location_val;
            $contents = HotelContent::where('language_id', $language->id)
                ->where('address', 'like', '%' . $address . '%')
                ->pluck('hotel_id');

            foreach ($contents as $content) {
                if (!in_array($content, $addressIds)) {
                    $addressIds[] = $content;
                }
            }
        }
    }

    $order_by_column = 'hotels.serial_number';
    $order = 'asc';
    $usePopularityOrder = true;

    if ($request->filled('sort')) {
        $usePopularityOrder = false;
        if ($request['sort'] == 'old') {
            $order_by_column = 'rooms.id';
            $order = 'asc';
        } else {
            $order_by_column = 'rooms.id';
            $order = 'desc';
        }
    }

    // Pipeline query structure for featured content sections
    $featured_contents = RoomContent::join('rooms', 'rooms.id', '=', 'room_contents.room_id')
        ->join('room_features', 'rooms.id', '=', 'room_features.room_id')
        ->join('hotels', 'rooms.hotel_id', '=', 'hotels.id')
        ->join('room_categories', 'room_contents.room_category', '=', 'room_categories.id')
        ->join('hotel_contents', 'rooms.hotel_id', '=', 'hotel_contents.hotel_id')
        ->join('hotel_categories', 'hotel_contents.category_id', '=', 'hotel_categories.id')
        ->where('hotel_contents.language_id', $language->id)
        ->where('room_categories.status', 1)
        ->where('hotel_categories.status', 1)
        ->where('room_contents.language_id', $language->id)
        ->where('room_features.order_status', 'apporved')
        ->where('rooms.status', '1')
        ->where('hotels.status', '1')->where('hotels.approval_status', 1)
        ->whereDate('room_features.end_date', '>=', Carbon::now()->format('Y-m-d'))
        ->when($title, function ($query) use ($roomIds) {
            return $query->whereIn('rooms.id', $roomIds);
        })
        ->when($country, function ($query) use ($countryIds) {
            return $query->whereIn('rooms.hotel_id', $countryIds);
        })
        ->when($state, function ($query) use ($stateIds) {
            return $query->whereIn('rooms.hotel_id', $stateIds);
        })
        ->when($city, function ($query) use ($cityIds) {
            return $query->whereIn('rooms.hotel_id', $cityIds);
        })
        ->when($hotelId, function ($query) use ($hotelId) {
            return $query->where('rooms.hotel_id', $hotelId);
        })
        ->when($category, function ($query) use ($category_roomIds) {
            return $query->whereIn('rooms.id', $category_roomIds);
        })
        ->when($ratings, function ($query) use ($ratingIds) {
            return $query->whereIn('rooms.id', $ratingIds);
        })
        ->when(!empty($coupleFriendlyIds), function ($query) use ($coupleFriendlyIds) {
            return $query->whereIn('rooms.id', $coupleFriendlyIds);
            })
            ->when(!empty($categoryFilteredIds), function ($query) use ($categoryFilteredIds) {
                return $query->whereIn('rooms.id', $categoryFilteredIds);
            })
            ->when(!empty($cityFilteredIds), function ($query) use ($cityFilteredIds) {
                return $query->whereIn('rooms.id', $cityFilteredIds);
        })
        ->when($amenitie, function ($query) use ($amenitieIds) {
            return $query->whereIn('rooms.id', $amenitieIds);
        })
        ->when($checkInDates, function ($query) use ($roomtimeIds) {
            return $query->whereNotIn('rooms.id', $roomtimeIds);
        })
        ->when(!is_null($priceFilteredRoomIds), function ($query) use ($priceFilteredRoomIds) {
            return $query->whereIn('rooms.id', $priceFilteredRoomIds);
        })
        ->select(
            'rooms.*',
            'rooms.feature_image',
            'room_contents.title',
            'room_contents.slug',
            'room_contents.amenities',
            'hotels.id as hotelId',
            'hotels.stars as stars',
            'hotels.latitude as latitude',
            'hotels.longitude as longitude',
            'hotels.logo as hotelImage',
            'hotel_contents.title as hotelName',
            'hotel_contents.slug as hotelSlug',
            'hotel_contents.city_id',
            'hotel_contents.state_id',
            'hotel_contents.country_id'
        )
        ->when($filterCity, function ($query) use ($filterCity) {
            return $query->orderByRaw('CASE WHEN hotel_contents.city_id = ? THEN 0 ELSE 1 END ASC', [$filterCity]);
        })
        ->when($usePopularityOrder, function ($query) {
            return $query->orderByRaw('CASE WHEN hotels.serial_number = 0 THEN 1 ELSE 0 END ASC, hotels.serial_number ASC');
        })
        ->when(!$usePopularityOrder, function ($query) use ($order_by_column, $order) {
            return $query->orderBy($order_by_column, $order);
        })
        ->inRandomOrder()
        ->get();

    $featured_contents = $featured_contents->take(3);
    $featured_contentsIds = [];

    foreach ($featured_contents as $content) {
        if (!in_array($content->id, $featured_contentsIds)) {
            $featured_contentsIds[] = $content->id;
        }
    }

    // Main standard search scope
    $room_contents = RoomContent::join('rooms', 'rooms.id', '=', 'room_contents.room_id')
        ->join('hotels', 'rooms.hotel_id', '=', 'hotels.id')
        ->join('room_categories', 'room_contents.room_category', '=', 'room_categories.id')
        ->join('hotel_contents', 'rooms.hotel_id', '=', 'hotel_contents.hotel_id')
        ->join('hotel_categories', 'hotel_contents.category_id', '=', 'hotel_categories.id')
        ->where('hotel_contents.language_id', $language->id)
        ->where('room_categories.status', 1)
        ->where('hotel_categories.status', 1)
        ->where('room_contents.language_id', $language->id)
        ->where('rooms.status', '1')
        ->where('hotels.status', '1')->where('hotels.approval_status', 1)
        ->when($title, function ($query) use ($roomIds) {
            return $query->whereIn('rooms.id', $roomIds);
        })
        ->when($country, function ($query) use ($countryIds) {
            return $query->whereIn('rooms.hotel_id', $countryIds);
        })
        ->when($state, function ($query) use ($stateIds) {
            return $query->whereIn('rooms.hotel_id', $stateIds);
        })
        ->when($city, function ($query) use ($cityIds) {
            return $query->whereIn('rooms.hotel_id', $cityIds);
        })
        ->when($hotelId, function ($query) use ($hotelId) {
            return $query->where('rooms.hotel_id', $hotelId);
        })
        ->when($category, function ($query) use ($category_roomIds) {
            return $query->whereIn('rooms.id', $category_roomIds);
        })
        ->when($ratings, function ($query) use ($ratingIds) {
            return $query->whereIn('rooms.id', $ratingIds);
        })
        ->when(!empty($coupleFriendlyIds), function ($query) use ($coupleFriendlyIds) {
            return $query->whereIn('rooms.id', $coupleFriendlyIds);
            })
            ->when(!empty($categoryFilteredIds), function ($query) use ($categoryFilteredIds) {
                return $query->whereIn('rooms.id', $categoryFilteredIds);
            })
            ->when(!empty($cityFilteredIds), function ($query) use ($cityFilteredIds) {
                return $query->whereIn('rooms.id', $cityFilteredIds);
        })
        ->when($amenitie, function ($query) use ($amenitieIds) {
            return $query->whereIn('rooms.id', $amenitieIds);
        })
        ->when($checkInDates, function ($query) use ($roomtimeIds) {
            return $query->whereNotIn('rooms.id', $roomtimeIds);
        })
        ->when(count($featured_contentsIds) > 0, function ($query) use ($featured_contentsIds) {
            return $query->whereNotIn('rooms.id', $featured_contentsIds);
        })
        ->when(!is_null($priceFilteredRoomIds), function ($query) use ($priceFilteredRoomIds) {
            return $query->whereIn('rooms.id', $priceFilteredRoomIds);
        })
        ->select(
            'rooms.*',
            'rooms.feature_image',
            'room_contents.title',
            'room_contents.slug',
            'room_contents.amenities',
            'hotels.id as hotelId',
            'hotels.stars as stars',
            'hotels.latitude as latitude',
            'hotels.longitude as longitude',
            'hotels.logo as hotelImage',
            'hotel_contents.title as hotelName',
            'hotel_contents.slug as hotelSlug',
            'hotel_contents.city_id',
            'hotel_contents.state_id',
            'hotel_contents.country_id'
        )
        ->when($filterCity, function ($query) use ($filterCity) {
            return $query->orderByRaw('CASE WHEN hotel_contents.city_id = ? THEN 0 ELSE 1 END ASC', [$filterCity]);
        })
        ->when($usePopularityOrder, function ($query) {
            return $query->orderByRaw('CASE WHEN hotels.serial_number = 0 THEN 1 ELSE 0 END ASC, hotels.serial_number ASC');
        })
        ->when(!$usePopularityOrder, function ($query) use ($order_by_column, $order) {
            return $query->orderBy($order_by_column, $order);
        })
        ->get();

    $roomQuery = $room_contents;
    $perPage = 12;
    $page = $request->query('page', 1);
    $offset = ($page - 1) * $perPage;

    $room_contents = new LengthAwarePaginator(
        $room_contents->slice($offset, $perPage)->values(),
        $room_contents->count(),
        $perPage,
        $page,
        [
            'path' => request()->url(),
            'query' => request()->query()
        ]
    );

    $information['roomQuery'] = $roomQuery;
    $information['room_contents'] = $room_contents;
    $information['featured_contents'] = $featured_contents;
    $information['perPage'] = $perPage;
    $information['hotelbs'] = $bs;

    $information['categories'] = RoomCategory::where('language_id', $language->id)
        ->where('status', 1)
        ->orderBy('serial_number', 'asc')
        ->get();

    $information['vendors'] = Vendor::join('memberships', 'vendors.id', '=', 'memberships.vendor_id')
        ->where([
            ['memberships.status', '=', 1],
            ['memberships.start_date', '<=', Carbon::now()->format('Y-m-d')],
            ['memberships.expire_date', '>=', Carbon::now()->format('Y-m-d')]
        ])
        ->get();

    $information['countries'] = Country::where('language_id', $language->id)->orderBy('id', 'asc')->get();
    $information['states'] = State::where('language_id', $language->id)->orderBy('id', 'asc')->get();
    $information['locations'] = City::where('language_id', $language->id)->orderBy('id', 'asc')->get();
    $information['bookingHours'] = BookingHour::orderBy('hour', 'asc')->get();
    $information['amenities'] = Amenitie::where('language_id', $language->id)->get();

    $information['hotels'] = Hotel::join('hotel_contents', 'hotels.id', '=', 'hotel_contents.hotel_id')
        ->where('hotel_contents.language_id', $language->id)
        ->select('hotels.id', 'hotel_contents.title')
        ->orderBy('hotels.id', 'desc')
        ->get();

    $information['adultNumber'] = Room::where('status', 1)->max('adult');
    $information['childrenNumber'] = Room::where('status', 1)->max('children');

    return view('frontend.room.room-gird', $information);
}

    public function getAddress(Request $request)
    {
        $country = $state = $city = null;
        if ($request->country_id) {
            $country = Country::where('id', $request->country_id)->first()->name;
        }
        if ($request->state_id) {
            $state = State::where('id', $request->state_id)->first()->name;
        }
        if ($request->city_id) {
            $city = City::where('id', $request->city_id)->first()->name;
        }
        $address = '';
        if ($request->city_id && $city) {
            $address .= $city;
        }
        if ($request->state_id && $state) {
            $address .= ($address ? ', ' : '') . $state;
        }
        if ($request->country_id && $country) {
            $address .= ($address ? ', ' : '') . $country;
        }

        return $address;
    }

    public function search_room(Request $request)
    {
        $misc = new MiscellaneousController();
        $language = $misc->getLanguage();
        $information['language'] = $language;
        $information['currencyInfo'] = $this->getCurrencyInfo();
        
